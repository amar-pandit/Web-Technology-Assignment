# Block all direct web access to uploaded files.
# Files are served only through download.php after a database check.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Never execute scripts from this folder
php_flag engine off
Options -ExecCGI -Indexes
